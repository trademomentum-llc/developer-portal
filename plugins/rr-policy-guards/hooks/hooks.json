{
  "description": "Policy guards for the Rational Reserve platform. Four PreToolUse hooks: rr-emoji-guard on file writes; rr-bash-guard + rr-brew-guard + rr-tofu-guard on Bash. All four audit-log to ~/.rational-reserve/logs/ and respect their own RR_*_GUARD_BYPASS=1 env vars.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/rr-emoji-guard",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/rr-bash-guard"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/rr-brew-guard"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/rr-tofu-guard"
          }
        ]
      }
    ]
  }
}
