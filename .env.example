# developer-portal -- example environment (copy to .env, which is gitignored).
# Never commit real values. Leave a variable empty to use the fallback.

# OpenSearch admin password seeded into OpenBao KV secret/opensearch-password
# by scripts/bootstrap-openbao-persistent.sh. Resolution order:
#   1. OPENSEARCH_ADMIN_PASSWORD (if set and non-empty)
#   2. the file at OPENSEARCH_ADMIN_PASSWORD_FILE
#      (default: ~/.rational-reserve/openbao/opensearch-admin-password)
#   3. otherwise a random 32-char value is generated into that file (mode 600)
# OpenSearch itself must be configured with the same value.
OPENSEARCH_ADMIN_PASSWORD=
OPENSEARCH_ADMIN_PASSWORD_FILE=

# Fail-fast: set to 1 to refuse step 3 (no generation, no default); the
# bootstrap exits before touching OpenBao unless 1 or 2 supplies a value.
OPENBAO_REQUIRE_EXPLICIT_SECRETS=0
