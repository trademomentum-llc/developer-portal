# Local development overrides for Backstage.
# Copy this file to app-config.local.yaml and adjust values.
# These flags are intentionally NOT in app-config.yaml so production config
# remains secure. Backstage loads app-config.local.yaml automatically in
# development mode.
backend:
  # Use a file-backed database directory in local dev so catalog state survives restarts.
  # The directory will be created automatically and each plugin gets its own .sqlite file.
  database:
    client: better-sqlite3
    connection:
      directory: ${HOME}/.rational-reserve/backstage-db

# In dev the frontend origin (:3001) proxies /api to the backend (:7008) via
# the "proxy" field in packages/app/package.json. The fetch middleware only
# attaches the Backstage token to URLs matching backend.baseUrl or the
# discovery.endpoints prefixes below, so allowlist the proxied /api/proxy
# prefix to keep relative fetches authenticated (same-origin prod is matched
# by backend.baseUrl already).
discovery:
  endpoints:
    - target: http://localhost:3001/api/{{pluginId}}
      plugins: [proxy]

auth:
  environment: development
  providers:
    guest: {}
    gitea:
      development:
        clientId: ${GITEA_OAUTH_CLIENT_ID}
        clientSecret: ${GITEA_OAUTH_CLIENT_SECRET}
        # Authenticate against the local Gitea instance. Both Backstage and
        # Gitea are on localhost, so the OAuth nonce cookie is same-site and
        # the flow works without a proxy.
        hostname: localhost:3333
        secure: false

app:
  extensions:
    # Replace the default Backstage sign-in page with the custom Gitea + guest page.
    # Backstage logs an INVALID_EXTENSION_CONFIG_KEY warning for this key, but
    # without it the default sign-in page collides with the custom one.
    - app/sign-in-page: false

permission:
  enabled: false
