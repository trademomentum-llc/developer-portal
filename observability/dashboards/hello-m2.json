{
  "schemaVersion": "v6",
  "name": "hello-m2-red",
  "tags": [
    {"key": "milestone", "value": "m3"},
    {"key": "managed-by", "value": "developer-portal"}
  ],
  "spec": {
    "display": {
      "name": "hello-m2: RED + Recent Errors",
      "description": "FR-08: request rate, error rate, p95 latency derived by the spanmetrics connector (FR-07), plus recent error logs from the filelog receiver (FR-05). Tenancy filter key: openchoreo.project (FR-11)."
    },
    "duration": "1h",
    "datasources": {
      "SigNozDatasource": {
        "default": true,
        "plugin": {"kind": "signoz/Datasource", "spec": {}}
      }
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "project",
          "display": {"name": "openchoreo.project"},
          "allowAllValue": true,
          "allowMultiple": false,
          "sort": "none",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {"name": "openchoreo.project", "signal": "metrics"}
          }
        }
      }
    ],
    "panels": {
      "aa10bb01": {
        "kind": "Panel",
        "spec": {
          "display": {"name": "Request rate (req/s)", "description": "spanmetrics_calls_total rate per span"},
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "formatting": {"unit": "none", "decimalPrecision": "2"},
              "legend": {"position": "bottom"}
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "aggregations": [
                      {
                        "metricName": "spanmetrics_calls_total",
                        "reduceTo": "sum",
                        "spaceAggregation": "sum",
                        "timeAggregation": "rate"
                      }
                    ],
                    "filter": {"expression": "service.name = 'hello-m2' AND openchoreo.project IN $project"},
                    "groupBy": [
                      {"name": "span.name", "fieldDataType": "string", "fieldContext": "tag"}
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "aa10bb02": {
        "kind": "Panel",
        "spec": {
          "display": {"name": "Error rate (errors/s)", "description": "spanmetrics calls with STATUS_CODE_ERROR"},
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "formatting": {"unit": "none", "decimalPrecision": "3"},
              "legend": {"position": "bottom"}
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "aggregations": [
                      {
                        "metricName": "spanmetrics_calls_total",
                        "reduceTo": "sum",
                        "spaceAggregation": "sum",
                        "timeAggregation": "rate"
                      }
                    ],
                    "filter": {"expression": "service.name = 'hello-m2' AND status.code = 'STATUS_CODE_ERROR' AND openchoreo.project IN $project"},
                    "groupBy": [
                      {"name": "span.name", "fieldDataType": "string", "fieldContext": "tag"}
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "aa10bb03": {
        "kind": "Panel",
        "spec": {
          "display": {"name": "Latency p95 (ms)", "description": "spanmetrics_duration_milliseconds p95 per span"},
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "formatting": {"unit": "ms", "decimalPrecision": "1"},
              "legend": {"position": "bottom"}
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "aggregations": [
                      {
                        "metricName": "spanmetrics_duration_milliseconds_bucket",
                        "reduceTo": "avg",
                        "spaceAggregation": "p95",
                        "timeAggregation": "rate"
                      }
                    ],
                    "filter": {"expression": "service.name = 'hello-m2' AND openchoreo.project IN $project"},
                    "groupBy": [
                      {"name": "span.name", "fieldDataType": "string", "fieldContext": "tag"}
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "aa10bb04": {
        "kind": "Panel",
        "spec": {
          "display": {"name": "Recent error logs", "description": "Pod logs for the component whose body mentions an error (filelog receiver)"},
          "plugin": {
            "kind": "signoz/ListPanel",
            "spec": {
              "selectFields": [
                {"name": "timestamp", "signal": "logs"},
                {"name": "body", "signal": "logs"}
              ]
            }
          },
          "queries": [
            {
              "kind": "raw",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "logs",
                    "aggregations": [{"expression": "count() "}],
                    "filter": {"expression": "openchoreo.component = 'hello-m2' AND body CONTAINS 'error'"},
                    "groupBy": [],
                    "order": [
                      {"key": {"name": "timestamp"}, "direction": "desc"},
                      {"key": {"name": "id"}, "direction": "desc"}
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {"x": 0, "y": 0, "width": 6, "height": 6, "content": {"$ref": "#/spec/panels/aa10bb01"}},
            {"x": 6, "y": 0, "width": 6, "height": 6, "content": {"$ref": "#/spec/panels/aa10bb02"}},
            {"x": 0, "y": 6, "width": 6, "height": 6, "content": {"$ref": "#/spec/panels/aa10bb03"}},
            {"x": 6, "y": 6, "width": 6, "height": 6, "content": {"$ref": "#/spec/panels/aa10bb04"}}
          ]
        }
      }
    ]
  }
}
