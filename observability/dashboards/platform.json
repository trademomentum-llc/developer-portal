{
  "schemaVersion": "v6",
  "name": "platform-overview",
  "tags": [
    {"key": "milestone", "value": "m3"},
    {"key": "managed-by", "value": "developer-portal"}
  ],
  "spec": {
    "display": {
      "name": "Platform Overview",
      "description": "FR-08: cross-service RED coverage from spanmetrics (FR-07), pod log volume from the filelog receiver (FR-05), and Gatekeeper violations. Tenancy filter key: openchoreo.project (FR-11)."
    },
    "duration": "1h",
    "datasources": {
      "SigNozDatasource": {
        "default": true,
        "plugin": {"kind": "signoz/Datasource", "spec": {}}
      }
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "project",
          "display": {"name": "openchoreo.project"},
          "allowAllValue": true,
          "allowMultiple": false,
          "sort": "none",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {"name": "openchoreo.project", "signal": "metrics"}
          }
        }
      },
      {
        "kind": "ListVariable",
        "spec": {
          "name": "namespace",
          "display": {"name": "k8s.namespace.name"},
          "allowAllValue": true,
          "allowMultiple": false,
          "sort": "none",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {"name": "k8s.namespace.name", "signal": "logs"}
          }
        }
      }
    ],
    "panels": {
      "bb20cc01": {
        "kind": "Panel",
        "spec": {
          "display": {"name": "Spans ingested (1h)", "description": "Total trace spans across all instrumented services"},
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "formatting": {"unit": "none", "decimalPrecision": "0"}
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "aggregations": [{"expression": "count() "}]
                  }
                }
              }
            }
          ]
        }
      },
      "bb20cc02": {
        "kind": "Panel",
        "spec": {
          "display": {"name": "Request rate by service", "description": "spanmetrics_calls_total rate grouped by service.name"},
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "formatting": {"unit": "none", "decimalPrecision": "2"},
              "legend": {"position": "bottom"}
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "aggregations": [
                      {
                        "metricName": "spanmetrics_calls_total",
                        "reduceTo": "sum",
                        "spaceAggregation": "sum",
                        "timeAggregation": "rate"
                      }
                    ],
                    "filter": {"expression": "openchoreo.project IN $project"},
                    "groupBy": [
                      {"name": "service.name", "fieldDataType": "string", "fieldContext": "tag"}
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "bb20cc03": {
        "kind": "Panel",
        "spec": {
          "display": {"name": "Log volume by namespace", "description": "Pod log records collected by the filelog receiver"},
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "formatting": {"unit": "none", "decimalPrecision": "0"},
              "legend": {"position": "bottom"}
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "logs",
                    "aggregations": [{"expression": "count() "}],
                    "filter": {"expression": "k8s.namespace.name IN $namespace"},
                    "groupBy": [
                      {"name": "k8s.namespace.name", "fieldDataType": "string", "fieldContext": "resource"}
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "bb20cc04": {
        "kind": "Panel",
        "spec": {
          "display": {"name": "Gatekeeper violations (1h)", "description": "Audit events with event_type = violation_audited (Wave 0 receiver)"},
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "formatting": {"unit": "none", "decimalPrecision": "0"}
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "logs",
                    "aggregations": [{"expression": "count() "}],
                    "filter": {"expression": "process = 'audit' AND event_type = 'violation_audited'"}
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {"x": 0, "y": 0, "width": 6, "height": 6, "content": {"$ref": "#/spec/panels/bb20cc01"}},
            {"x": 6, "y": 0, "width": 6, "height": 6, "content": {"$ref": "#/spec/panels/bb20cc02"}},
            {"x": 0, "y": 6, "width": 6, "height": 6, "content": {"$ref": "#/spec/panels/bb20cc03"}},
            {"x": 6, "y": 6, "width": 6, "height": 6, "content": {"$ref": "#/spec/panels/bb20cc04"}}
          ]
        }
      }
    ]
  }
}
